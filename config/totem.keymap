//
// Totem ZMK Nordic Edition (Base: Multi-layer Gaming Layout + Nordic Double-Tap)
//

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

//
// ─── Custom Behaviors ────────────────────────────────────────────────────────────
//

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        // Double-tap macros for Nordic characters
        macro_o_dbl: macro_o_dbl {
            compatible = "zmk,behavior-tap-dance";
            label = "DoubleTapO";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&kp RA(O)>; // ø = AltGr+O
        };

        macro_a_dbl: macro_a_dbl {
            compatible = "zmk,behavior-tap-dance";
            label = "DoubleTapA";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp A>, <&kp RA(A)>; // å = AltGr+A
        };

        macro_ae_dbl: macro_ae_dbl {
            compatible = "zmk,behavior-tap-dance";
            label = "DoubleTapAE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SEMICOLON>, <&kp RA(SEMICOLON)>; // æ = AltGr+;
        };
    };

    combos {
        compatible = "zmk,combos";
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
                &kp Q        &kp W        &kp E        &kp R        &kp T         &kp Y         &kp U        &kp I        &macro_o_dbl   &kp P
      &hm LGUI &macro_a_dbl  &hm LALT S   &hm LCTRL D  &hm LSHIFT F  &kp G         &kp H         &hm RSHFT J  &hm RCTRL K  &macro_ae_dbl
&lt 3 ESCAPE   &kp Z        &kp X        &kp C        &kp V        &kp B         &kp N         &kp M        &kp COMMA    &kp DOT      &kp SLASH  &lt 4 APOSTROPHE
                              &mt LCTRL DEL    &lt 1 TAB   &kp SPACE   &kp RET   &lt 2 BSPC    &kp MINUS
            >;
        };

        // other layers unchanged (Nav, Sym, Fun, Button, Game, Gameplus)
    };
};
