//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// Totem ZMK Nordic Edition (Base: Multi-layer Gaming Layout + Nordic Double-Tap)
//

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Button      4
#define MacBase     5
#define MacNav      6
#define MacSym      7

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

//
// ─── Custom Behaviors ────────────────────────────────────────────────────────────
//

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        // Macros for Nordic characters
        aa_macro: aa_macro {
            compatible = "zmk,behavior-macro";
            label = "AA_MACRO";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RALT>
                , <&macro_tap &kp A>
                , <&macro_release &kp RALT>
                ;
        };

        ae_macro: ae_macro {
            compatible = "zmk,behavior-macro";
            label = "AE_MACRO";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RALT>
                , <&macro_tap &kp SEMICOLON>
                , <&macro_release &kp RALT>
                ;
        };

        oslash_macro: oslash_macro {
            compatible = "zmk,behavior-macro";
            label = "OSLASH_MACRO";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp RALT>
                , <&macro_tap &kp O>
                , <&macro_release &kp RALT>
                ;
        };

        // Hold-tap behaviors for Nordic characters
        ht_i_aa: ht_i_aa {
            compatible = "zmk,behavior-hold-tap";
            label = "I_AA";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        ht_o_ae: ht_o_ae {
            compatible = "zmk,behavior-hold-tap";
            label = "O_AE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        ht_p_oslash: ht_p_oslash {
            compatible = "zmk,behavior-hold-tap";
            label = "P_OSLASH";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
                &kp Q       &kp W       &kp E        &kp R        &kp T         &kp Y         &kp U       &ht_i_aa LBKT I       &ht_o_ae SQT O       &ht_p_oslash SEMI P
       &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F      &kp G         &kp H    &hm RSHFT J    &hm RCTRL K       &hm RALT L  &hm RGUI SEMICOLON
&lt Fun ESCAPE       &kp Z       &kp X          &kp C         &kp V      &kp B         &kp N         &kp M      &kp COMMA        &kp DOT           &kp SLASH  &lt Button APOSTROPHE
                                        &mt LCTRL DEL     &lt Nav TAB  &kp SPACE     &kp RET  &lt Sym BSPC        &kp MINUS
            >;
        };

        Nav {
            label = "Nav";
            bindings = <
                      &trans       &trans  &kp UP_ARROW     &trans  &kp LBRC  &kp RBRC  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9         &kp PLUS
              &kp LEFT_SHIFT     &kp LEFT      &kp DOWN  &kp RIGHT  &kp LBKT  &kp RBKT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6        &kp MINUS
&kp LEFT_ALT          &trans  &kp PAGE_UP        &trans  &kp PG_DN  &kp LPAR  &kp RPAR  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &trans
                                                 &trans     &trans    &trans    &trans        &trans  &kp NUMBER_0
            >;
        };

        Sym {
            label = "Sym";
            bindings = <
        &kp EXCL    &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp KP_ASTERISK  &kp LPAR   &kp RPAR
        &kp GRAVE  &kp TILDE  &kp PIPE   &kp BSLH     &kp LBRC   &kp RBRC      &kp HOME           &kp END  &kp LBKT   &kp RBKT
&trans    &kp SQT   &kp DQT    &kp LT     &kp GT     &kp LPAR   &kp RPAR      &kp MINUS         &kp UNDER  &kp EQUAL   &kp PLUS  &trans
                               &trans     &trans       &trans     &trans         &trans            &trans
            >;
        };

        Fun {
            label = "Fun";
            bindings = <
         &kp F1   &kp F2  &kp F3   &kp F4   &kp F5   &kp F6      &kp F7       &kp F8            &kp F9      &kp F10
        &kp F11  &kp F12  &kp SLASH  &kp BSLH   &to MacBase  &kp HOME  &kp PG_DN  &kp PG_UP      &kp END      &kp DEL
&trans   &trans   &trans  &kp SEMI  &kp COLON  &trans  &kp INS  &kp PSCRN    &kp PAUSE_BREAK  &kp SLCK  &kp CAPS  &trans
                           &trans   &trans  &trans   &trans     &trans       &trans
            >;
        };

        Button {
            label = "Button";
            bindings = <
                    &bt BT_CLR    &trans     &trans      &trans  &bt BT_SEL 0      &trans            &trans      &trans  &bootloader    &trans
                      &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &bt BT_SEL 1      &trans        &kp RSHIFT   &kp RCTRL     &kp RALT  &kp RGUI
&bootloader  &ext_power EP_TOG    &trans     &trans      &trans  &bt BT_SEL 2      &trans            &trans      &trans       &trans    &trans  &trans
                                             &trans      &trans        &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT
            >;
        };

        MacBase {
            label = "Mac";
            bindings = <
                &kp Q       &kp W       &kp E        &kp R        &kp T         &kp Y         &kp U       &ht_i_aa LBKT I       &ht_o_ae SQT O       &ht_p_oslash SEMI P
       &hm LALT A  &hm LGUI S  &hm LCTRL D  &hm LSHIFT F      &kp G         &kp H    &hm RSHFT J    &hm RCTRL K       &hm RGUI L  &hm RALT SEMICOLON
&lt MacSym ESCAPE       &kp Z       &kp X          &kp C         &kp V      &kp B         &kp N         &kp M      &kp COMMA        &kp DOT           &kp SLASH  &to Base
                                        &mt LCTRL DEL  &lt MacNav TAB  &kp SPACE     &kp RET  &lt MacSym BSPC        &kp MINUS
            >;
        };

        MacNav {
            label = "MacNav";
            bindings = <
                      &trans       &trans  &kp UP_ARROW     &trans  &kp LBRC  &kp RBRC  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9         &kp PLUS
              &kp LEFT_SHIFT     &kp LEFT      &kp DOWN  &kp RIGHT  &kp LBKT  &kp RBKT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6        &kp MINUS
&kp LEFT_GUI          &trans  &kp PAGE_UP        &trans  &kp PG_DN  &kp LPAR  &kp RPAR  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &trans
                                                 &trans     &trans    &trans    &trans        &trans  &kp NUMBER_0
            >;
        };

        MacSym {
            label = "MacSym";
            bindings = <
        &kp EXCL    &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp KP_ASTERISK  &kp LPAR   &kp RPAR
        &kp GRAVE  &kp TILDE  &kp PIPE   &kp BSLH     &kp LBRC   &kp RBRC      &kp HOME           &kp END  &kp LBKT   &kp RBKT
&trans    &kp SQT   &kp DQT    &kp LT     &kp GT     &kp LPAR   &kp RPAR      &kp MINUS         &kp UNDER  &kp EQUAL   &kp PLUS  &trans
                               &trans     &trans       &trans     &trans         &trans            &trans
            >;
        };
    };
};
