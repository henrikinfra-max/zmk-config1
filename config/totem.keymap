//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// Totem ZMK - Norwegian Programmer Edition
// Mac Primary + Windows Secondary | No Gaming Layers
// Nordic characters: å (I hold), æ (O hold), ø (P hold)
// OS Switching: F5 position in Fun layer
// Combos: N+M screenshot, Z+X F5

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

// Mac layers
#define MacBase     0
#define MacNav      1
#define MacSym      2
#define MacFun      3

// Windows layers
#define WinBase     4
#define WinNav      5
#define WinSym      6
#define WinFun      7

// Shared layer
#define Button      8

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        // Hold-tap for å (I hold)
        ht_i_aa: ht_i_aa {
            compatible = "zmk,behavior-hold-tap";
            label = "I_AA";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // Hold-tap for æ (O hold)
        ht_o_ae: ht_o_ae {
            compatible = "zmk,behavior-hold-tap";
            label = "O_AE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // Hold-tap for ø (P hold)
        ht_p_oslash: ht_p_oslash {
            compatible = "zmk,behavior-hold-tap";
            label = "P_OSLASH";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Mac screenshot: N+M = Cmd+Shift+4
        combo_mac_screenshot {
            bindings = <&kp LG(LS(N4))>;
            key-positions = <26 27>;
            layers = <0>;
        };

        // Windows screenshot: N+M = Win+Shift+S
        combo_win_screenshot {
            bindings = <&kp LG(LS(S))>;
            key-positions = <26 27>;
            layers = <4>;
        };

        // Mac F5: Z+X
        combo_f5_mac {
            bindings = <&kp F5>;
            key-positions = <21 22>;
            layers = <0>;
        };

        // Windows F5: Z+X
        combo_f5_win {
            bindings = <&kp F5>;
            key-positions = <21 22>;
            layers = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────────────────────────────────────
        // MAC BASE LAYER (Primary)
        // ─────────────────────────────────────────────────────────────
        MacBase {
            label = "Mac";
            bindings = <
                   &kp Q       &kp W       &kp E        &kp R      &kp T         &kp Y         &kp U       &ht_i_aa LBKT I       &ht_o_ae SQT O       &ht_p_oslash SEMI P
              &hm LALT A  &hm LGUI S  &hm LCTRL D  &hm LSHIFT F      &kp G         &kp H    &hm RSHFT J    &hm RCTRL K       &hm RGUI L            &hm RALT SEMICOLON
&lt MacFun ESCAPE       &kp Z       &kp X          &kp C         &kp V      &kp B         &kp N         &kp M      &kp COMMA        &kp DOT                &kp SLASH  &lt Button APOSTROPHE
                                           &mt LGUI DEL  &lt MacNav TAB  &kp SPACE     &kp RET  &lt MacSym BSPC        &kp MINUS
            >;
        };

        // ─────────────────────────────────────────────────────────────
        // MAC NAV LAYER (Numbers, Navigation, Arrows)
        // ─────────────────────────────────────────────────────────────
        MacNav {
            label = "Nav";
            bindings = <
              &kp LS(N1)    &kp BSLH   &kp UP       &kp LS(N3)  &kp LS(N5)  &trans       &kp N7        &kp N8        &kp N9         &kp KP_PLUS
              &kp LGUI      &kp LEFT   &kp DOWN     &kp RIGHT   &kp LS(N4)  &kp LS(N6)   &kp N4        &kp N5        &kp N6        &kp KP_MINUS
&kp LCTRL     &kp HOME      &kp PG_UP  &kp PG_DN    &kp END     &kp LS(N7)  &kp LS(N0)   &kp N1        &kp N2        &kp N3        &kp KP_MULTIPLY  &kp KP_DIVIDE
                                       &trans       &trans      &trans      &trans       &kp N0        &kp DOT
            >;
        };

        // ─────────────────────────────────────────────────────────────
        // MAC SYM LAYER (All Programming Symbols)
        // Norwegian layout keycodes
        // ─────────────────────────────────────────────────────────────
        MacSym {
            label = "Sym";
            bindings = <
        &kp LS(N1)    &kp BSLH        &kp LS(N3)      &kp LS(N4)    &kp LS(N5)     &kp LS(N6)      &kp LS(N7)    &kp LS(N8)       &kp LS(N9)      &kp LS(N0)
        &kp RA(N8)    &kp LS(N8)      &kp RA(N7)      &kp NUBS      &kp LS(EQUAL)  &kp EQUAL       &kp LS(NUBS)  &kp RA(N9)       &kp LS(N9)      &kp RA(N0)
&trans  &kp N0        &kp PLUS        &kp MINUS       &kp LS(MINUS) &kp RBKT       &kp LS(RBKT)    &kp SQT       &kp LS(SQT)      &kp GRAVE       &kp LS(GRAVE)  &trans
                                      &trans          &trans        &trans         &trans          &trans        &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────
        // MAC FUN LAYER (F-keys, System, OS Switch)
        // F5 position = Switch to Windows mode
        // ─────────────────────────────────────────────────────────────
        MacFun {
            label = "Fun";
            bindings = <
         &kp F1   &kp F2   &kp F3   &kp F4        &to WinBase  &kp F6   &kp F7   &kp F8          &kp F9       &kp F10
        &kp F11  &kp F12   &trans   &trans        &trans       &trans   &kp HOME &kp PG_DN       &kp PG_UP    &kp END
&trans   &trans   &trans   &trans   &trans        &trans       &kp INS  &kp DEL  &kp PAUSE_BREAK &kp SLCK     &kp CAPS  &trans
                           &trans   &trans        &trans       &trans   &trans   &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────
        // WINDOWS BASE LAYER
        // ─────────────────────────────────────────────────────────────
        WinBase {
            label = "Win";
            bindings = <
                   &kp Q       &kp W       &kp E        &kp R      &kp T         &kp Y         &kp U       &ht_i_aa LBKT I       &ht_o_ae SQT O       &ht_p_oslash SEMI P
              &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F      &kp G         &kp H    &hm RSHFT J    &hm RCTRL K       &hm RALT L            &hm LGUI SEMICOLON
&lt WinFun ESCAPE       &kp Z       &kp X          &kp C         &kp V      &kp B         &kp N         &kp M      &kp COMMA        &kp DOT                &kp SLASH  &lt Button APOSTROPHE
                                           &mt LCTRL DEL  &lt WinNav TAB  &kp SPACE     &kp RET  &lt WinSym BSPC        &kp MINUS
            >;
        };

        // ─────────────────────────────────────────────────────────────
        // WINDOWS NAV LAYER (identical to Mac Nav)
        // ─────────────────────────────────────────────────────────────
        WinNav {
            label = "WNav";
            bindings = <
              &kp LS(N1)    &kp BSLH   &kp UP       &kp LS(N3)  &kp LS(N5)  &trans       &kp N7        &kp N8        &kp N9         &kp KP_PLUS
              &kp LSHIFT    &kp LEFT   &kp DOWN     &kp RIGHT   &kp LS(N4)  &kp LS(N6)   &kp N4        &kp N5        &kp N6        &kp KP_MINUS
&kp LCTRL     &kp HOME      &kp PG_UP  &kp PG_DN    &kp END     &kp LS(N7)  &kp LS(N0)   &kp N1        &kp N2        &kp N3        &kp KP_MULTIPLY  &kp KP_DIVIDE
                                       &trans       &trans      &trans      &trans       &kp N0        &kp DOT
            >;
        };

        // ─────────────────────────────────────────────────────────────
        // WINDOWS SYM LAYER (identical to Mac Sym)
        // ─────────────────────────────────────────────────────────────
        WinSym {
            label = "WSym";
            bindings = <
        &kp LS(N1)    &kp BSLH        &kp LS(N3)      &kp LS(N4)    &kp LS(N5)     &kp LS(N6)      &kp LS(N7)    &kp LS(N8)       &kp LS(N9)      &kp LS(N0)
        &kp RA(N8)    &kp LS(N8)      &kp RA(N7)      &kp NUBS      &kp LS(EQUAL)  &kp EQUAL       &kp LS(NUBS)  &kp RA(N9)       &kp LS(N9)      &kp RA(N0)
&trans  &kp N0        &kp PLUS        &kp MINUS       &kp LS(MINUS) &kp RBKT       &kp LS(RBKT)    &kp SQT       &kp LS(SQT)      &kp GRAVE       &kp LS(GRAVE)  &trans
                                      &trans          &trans        &trans         &trans          &trans        &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────
        // WINDOWS FUN LAYER (F-keys, System, OS Switch back to Mac)
        // F5 position = Switch back to Mac mode
        // ─────────────────────────────────────────────────────────────
        WinFun {
            label = "WFun";
            bindings = <
         &kp F1   &kp F2   &kp F3   &kp F4        &to MacBase  &kp F6   &kp F7   &kp F8          &kp F9       &kp F10
        &kp F11  &kp F12   &trans   &trans        &trans       &trans   &kp HOME &kp PG_DN       &kp PG_UP    &kp END
&trans   &trans   &trans   &trans   &trans        &trans       &kp INS  &kp DEL  &kp PAUSE_BREAK &kp SLCK     &kp CAPS  &trans
                           &trans   &trans        &trans       &trans   &trans   &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────
        // BUTTON LAYER (Bluetooth, Media, Bootloader)
        // Hold apostrophe to access
        // ─────────────────────────────────────────────────────────────
        Button {
            label = "BT";
            bindings = <
                    &bt BT_CLR    &trans     &trans      &trans  &bt BT_SEL 0      &trans            &trans      &trans  &bootloader    &trans
                      &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &bt BT_SEL 1      &trans        &kp RSHIFT   &kp RCTRL     &kp RALT  &kp LGUI
&bootloader  &ext_power EP_TOG    &trans     &trans      &trans  &bt BT_SEL 2      &trans            &trans      &trans       &trans    &trans  &trans
                                             &trans      &trans        &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT
            >;
        };
    };
};
